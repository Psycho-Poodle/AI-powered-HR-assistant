# Copy to .env and replace BOTH password placeholders with different local values.
# These credentials initialize local Docker clusters; never use production secrets.
POSTGRES_DB=hr_dev
POSTGRES_USER=hr_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
TEST_POSTGRES_DB=hr_test
TEST_POSTGRES_USER=hr_test
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_PORT=5433
API_PORT=8000
FRONTEND_PORT=5173
# Required only when running the seed command; no default demo password.
DEMO_SEED_PASSWORD=
# Generate a random secret of at least 32 characters; required for API startup.
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
# Use the exact UI origin above; for API-only access use http://localhost:8000.
# Local HTTP demo only; use true behind HTTPS.
SESSION_COOKIE_SECURE=false
# Optional host cache override; otherwise use .cache/embeddings/<pinned revision>.
# EMBEDDING_MODEL_PATH=/absolute/path/to/pinned-model-directory
